# Copy this file to `.env` and fill in the keys.
# `.env` itself is gitignored — never commit real keys here.

# Groq API key — writes captions with Llama 3.3 70B
# Get one at https://console.groq.com — starts with `gsk_...`
GROQ_API_KEY=

# Together AI API key — generates post images with FLUX.1-schnell
# Get one at https://api.together.ai — $1 free signup credit = ~333 images
TOGETHER_API_KEY=


VITE_SUPABASE_URL=

VITE_SUPABASE_ANON_KEY=

# --- Server-only (never expose to the client) ---

# Same base URL as VITE_SUPABASE_URL, without the /rest/v1/ suffix.
SUPABASE_URL=

# Supabase service role key — needed on the server to write the Instagram
# connection to the user's metadata after OAuth callback.
# Get it from Supabase → Project settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook Login for Business — Instagram Graph API credentials.
# From Meta Developers → your App → Settings → Basic.
FB_APP_ID=
FB_APP_SECRET=

# Must exactly match one of the Valid OAuth Redirect URIs configured in
# Meta → Facebook Login for Business → Settings.
# Prod:  https://<your-domain>/auth/facebook/callback
# Local: http://localhost:8080/auth/facebook/callback
FB_REDIRECT_URI=

# Random string used to HMAC-sign the OAuth `state` parameter so a callback
# can prove which user id requested the connection. Any 32+ char secret.
FB_OAUTH_SECRET=